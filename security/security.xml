<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================
         Module Category
         ========================= -->
    <record id="module_category_attendance" model="ir.module.category">
        <field name="name">Attendance</field>
        <field name="sequence">30</field>
    </record>

    <!-- =========================
         Groups
         ========================= -->
    <record id="group_attendance_user" model="res.groups">
        <field name="name">Attendance User</field>
        <field name="category_id" ref="employee_attendance_management.module_category_attendance"/>
    </record>

    <record id="group_attendance_manager" model="res.groups">
        <field name="name">Attendance Manager</field>
        <field name="category_id" ref="employee_attendance_management.module_category_attendance"/>
        <field name="implied_ids" eval="[(4, ref('employee_attendance_management.group_attendance_user'))]"/>
    </record>

    <!-- =========================
         Record Rules
         ========================= -->

    <!-- 1) Users: only their own attendance records -->
    <record id="rule_attendance_user_own_records" model="ir.rule">
        <field name="name">Attendance: user own records only</field>
        <field name="model_id" ref="employee_attendance_management.model_employee_attendance_record"/>
        <!-- ✅ FIX: بعد ما غيرنا لـ hr.employee -->
        <field name="domain_force">[('employee_id', '=', user.employee_id.id)]</field>
        <field name="groups" eval="[(4, ref('employee_attendance_management.group_attendance_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- 2) Managers: all records -->
    <record id="rule_attendance_manager_all_records" model="ir.rule">
        <field name="name">Attendance: manager all records</field>
        <field name="model_id" ref="employee_attendance_management.model_employee_attendance_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('employee_attendance_management.group_attendance_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>