<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="attendance_report_template">
        <!-- ✅ html_container هو اللي بيضيف <main> -->
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <t t-set="o" t-value="docs and docs[0] or False"/>

                <div class="page">
                    <h2>Attendance Report</h2>

                    <t t-if="o">
                        <p>
                            <strong>Employee:</strong>
                            <span t-field="o.employee_id"/>
                            <br/>
                            <strong>Date:</strong>
                            <span t-field="o.date"/>
                        </p>
                    </t>

                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Employee</th>
                                <th>Status</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th class="text-end">Worked Hours</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="docs" t-as="rec">
                                <tr>
                                    <td><span t-field="rec.date"/></td>
                                    <td><span t-field="rec.employee_id"/></td>
                                    <td>
                                        <t t-esc="dict(rec._fields['state'].selection).get(rec.state)"/>
                                    </td>
                                    <td><span t-field="rec.check_in"/></td>
                                    <td><span t-field="rec.check_out"/></td>
                                    <td class="text-end">
                                        <t t-esc="'%.2f' % rec.worked_hours"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>

            </t>
        </t>
    </template>

</odoo>