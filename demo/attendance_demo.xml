         ===================================================== -->

    <!-- Ahmed: Checked in on time at 8:45 AM, still working -->
    <record id="att_demo_today_ahmed" model="employee.attendance.record">
        <field name="employee_id" ref="employee_demo_1"/>
        <field name="date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        <field name="check_in" eval="DateTime.now().replace(hour=8, minute=45, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="state">present</field>
        <field name="notes">On time as usual</field>
    </record>

