<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_attendance_summary_tree" model="ir.ui.view">
        <field name="name">attendance.summary.tree</field>
        <field name="model">employee.attendance.summary</field>
        <field name="arch" type="xml">
            <tree string="Monthly Summary">
                <field name="employee_id"/>
                <field name="month_display"/>
                <field name="total_days"/>
                <field name="present_days"/>
                <field name="late_days"/>
                <field name="absent_days"/>
                <field name="approved_days"/>
                <field name="total_hours" sum="Total Hours"/>
            </tree>
        </field>
    </record>

    <record id="view_attendance_summary_form" model="ir.ui.view">
        <field name="name">attendance.summary.form</field>
        <field name="model">employee.attendance.summary</field>
        <field name="arch" type="xml">
            <form string="Monthly Summary">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="month_display" readonly="1"/>
                        </group>
                        <group>
                            <field name="present_days"/>
                            <field name="late_days"/>
                            <field name="absent_days"/>
                            <field name="approved_days"/>
                            <field name="total_hours"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance_summary" model="ir.actions.act_window">
        <field name="name">Monthly Summary</field>
        <field name="res_model">employee.attendance.summary</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_attendance_summary"
              name="Monthly Summary"
              parent="menu_attendance_root"
              action="action_attendance_summary"
              sequence="20"
              groups="employee_attendance_management.group_attendance_manager"/>

</odoo>
