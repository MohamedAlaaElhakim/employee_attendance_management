<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
         WIZARD VIEW
         ========================= -->
    <record id="view_attendance_approve_wizard_form" model="ir.ui.view">
        <field name="name">attendance.approve.wizard.form</field>
        <field name="model">attendance.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve Attendance">
                
                <group>
                    <group string="Attendance Details">
                        <field name="attendance_id" invisible="1"/>
                        <field name="employee_name"/>
                        <field name="date"/>
                        <field name="worked_hours" widget="float_time"/>
                    </group>
                    
                    <group string="Approval Options">
                        <field name="send_email"/>
                    </group>
                </group>
                
                <group>
                    <field name="note" placeholder="Add any notes about this approval (optional)..."/>
                </group>
                
                <footer>
                    <button name="action_confirm"
                            string="Approve"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- =========================
         WIZARD ACTION (المهم)
         ========================= -->
    <record id="action_attendance_approve_wizard" model="ir.actions.act_window">
        <field name="name">Approve Attendance</field>
        <field name="res_model">attendance.approve.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>